
programa {
    funcao inicio() {
        real nota
        
        escreva("Digite a nota do aluno:10 ")
        leia(nota)
        
        se (nota >= 7) {
            escreva("Aprovado! Parabéns!")
        } senao {
            escreva("Reprovado. Estude mais!")
        }
    }
}
                     